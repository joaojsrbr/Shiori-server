# ==============================================================================
# Shiori Server - Arquivo de Configuração de Exemplo
# Copie este arquivo para ".env" e altere os valores conforme sua necessidade.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações Globais
# ------------------------------------------------------------------------------
# Perfil de infraestrutura: 'portable' (banco local) ou 'docker' (serviços externos)
SHIORI_PROFILE=portable

# Diretório privado onde os dados do perfil portable serão armazenados
# SHIORI_DATA_DIR=./.shiori

# ------------------------------------------------------------------------------
# Servidor HTTP
# ------------------------------------------------------------------------------
# Endereço de escuta (em branco = escutar em todas as interfaces)
SHIORI_HOST=127.0.0.1

# Porta do servidor HTTP
SHIORI_PORT=8080

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
# Nível de logging (debug, info, warn, error)
SHIORI_LOG_LEVEL=info

# Formato dos logs (json, text, pretty)
SHIORI_LOG_FORMAT=pretty

# ------------------------------------------------------------------------------
# Inteligência Artificial (NuExtract / LM Studio)
# ------------------------------------------------------------------------------
# URL base da API do servidor de inferência local (LM Studio / llama.cpp / vLLM)
SHIORI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# Token de autenticação (caso aplicável)
SHIORI_LMSTUDIO_API_TOKEN=

# Modelos recomendados para diferentes níveis de qualidade
# SHIORI_MODEL_EXTRACT_TINY=nuextract-1.5-tiny
# SHIORI_MODEL_EXTRACT_DEFAULT=nuextract3@q4_k_m
# SHIORI_MODEL_EXTRACT_QUALITY=nuextract3@q5_k_m

# Use the same context window configured in LM Studio. A value greater than
# the actually loaded context can cause HTTP 400 during inference.
# SHIORI_AI_MAX_CONTEXT_LENGTH=8192
# SHIORI_AI_MAX_CONTENT_BYTES=12000

# ------------------------------------------------------------------------------
# Configurações do Perfil 'docker' (Apenas se SHIORI_PROFILE=docker)
# ------------------------------------------------------------------------------
# SHIORI_POSTGRES_URL=postgres://shiori:shiori@localhost:5432/shiori?sslmode=disable
# SHIORI_VALKEY_ADDR=localhost:6379
# SHIORI_MINIO_ENDPOINT=localhost:9000
# SHIORI_MINIO_ACCESS_KEY=shiori
# SHIORI_MINIO_SECRET_KEY=shiori-secret
# SHIORI_MINIO_BUCKET=shiori
# SHIORI_MINIO_USE_SSL=false
